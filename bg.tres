code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color;
uniform vec4 ColorParameter2 : source_color;



void fragment() {
// ColorParameter:13
	vec4 n_out13p0 = ColorParameter;


// ColorParameter:14
	vec4 n_out14p0 = ColorParameter2;


// Input:2
	vec2 n_out2p0 = UV;


// Input:6
	float n_out6p0 = TIME;


// FloatOp:9
	float n_in9p1 = 0.05000;
	float n_out9p0 = n_out6p0 * n_in9p1;


// VectorCompose:8
	float n_in8p1 = 0.00000;
	vec2 n_out8p0 = vec2(n_out9p0, n_in8p1);


// VectorOp:7
	vec2 n_out7p0 = n_out2p0 + n_out8p0;


// VectorOp:3
	vec2 n_in3p1 = vec2(10.00000, 1.00000);
	vec2 n_out3p0 = n_out7p0 * n_in3p1;


// VectorFunc:4
	vec2 n_out4p0 = fract(n_out3p0);


// VectorDecompose:10
	float n_out10p0 = vec3(n_out4p0, 0.0).x;
	float n_out10p1 = vec3(n_out4p0, 0.0).y;
	float n_out10p2 = vec3(n_out4p0, 0.0).z;


// SmoothStep:11
	float n_in11p0 = 0.50000;
	float n_in11p1 = 0.50500;
	float n_out11p0 = smoothstep(n_in11p0, n_in11p1, n_out10p0);


// Mix:15
	vec3 n_out15p0 = mix(vec3(n_out13p0.xyz), vec3(n_out14p0.xyz), vec3(n_out11p0));


// Output:0
	COLOR.rgb = n_out15p0;


}
